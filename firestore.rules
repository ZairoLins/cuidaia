rules_version = '2';

// Cada pessoa só acessa o próprio perfil, em usuarios/{uid}.
// Nada mais no banco pode ser lido ou escrito pelo app.
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read, delete: if ehDono(uid);
      // A data de criação é a do servidor e não muda depois.
      allow create: if ehDono(uid)
        && perfilValido(request.resource.data)
        && (!('criadoEm' in request.resource.data) || request.resource.data.criadoEm == request.time);
      allow update: if ehDono(uid)
        && perfilValido(request.resource.data)
        && request.resource.data.get('criadoEm', null) == resource.data.get('criadoEm', null);
    }

    function ehDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function perfilValido(d) {
      return d.keys().hasOnly(['nome', 'apelido', 'email', 'foto', 'criadoEm'])
        && d.nome is string && d.nome.size() <= 120
        && d.apelido is string && d.apelido.size() <= 60
        && d.email is string && d.email.size() <= 254
        // Foto opcional, no máximo 300 KB.
        && (!('foto' in d) || d.foto == null || (d.foto is bytes && d.foto.size() <= 307200))
        && (!('criadoEm' in d) || d.criadoEm is timestamp);
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
